# rag-eval-bench environment variables
# Copy to .env and edit as needed. Never commit .env to version control.

# ChromaDB persist directory (default: .rag-index in project root)
RAG_INDEX_DIR=.rag-index

# Ollama base URL (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Default Ollama model for generation scoring
OLLAMA_MODEL=gemma:2b

# Random seed for deterministic QA generation
QA_SEED=42

# Default number of QA pairs to generate
QA_N=100
